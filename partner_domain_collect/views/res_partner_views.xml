<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form_domain_collect" model="ir.ui.view">
        <field name="name">view.res.partner.form.domain.collect</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" class="oe_stat_button" icon="fa-user-plus"
                        name="action_view_potential_contacts" invisible="not is_company or not  potential_contact_count">
                    <field name="potential_contact_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//span[@name='address_name']" position="before">
                <field name="suggested_company_id_bareos"
                       string="Suggested companies"
                       options="{'no_create': True, 'no_create_edit': True}"
                       context="{'suggested_company_ids_bareos': suggested_company_ids_bareos}"
                       placeholder="Select a suggested company..."
                       invisible="not suggested_company_ids_bareos"/>
                <div invisible="not suggested_company_ids_bareos"/>
                <div class="d-flex gap-2 align-items-center"
                     invisible="not suggested_company_ids_bareos">
                    <field name="suggested_company_info_bareos" nolabel="1" readonly="1"/>
                    <button name="action_assign_suggested_company" type="object"
                            string="Add to company" class="btn-link" icon="fa-plus"
                            context="{'suggested_company_id_selected_bareos': suggested_company_id_bareos}"/>
                </div>
            </xpath>
            <notebook position="inside">
                <page string="Domains" invisible="not is_company">
                    <group>
                        <field name="domain_collect_ids_bareos">
                            <list editable="bottom">
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

<record id="view_partner_tree_domain_collect" model="ir.ui.view">
        <field name="name">res.partner.list.domain.collect</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="suggested_company_ids_bareos" optional="show"
                       widget="many2many_tags"/>
            </field>
        </field>
    </record>

    <record id="view_partner_search_domain_collect" model="ir.ui.view">
        <field name="name">res.partner.search.domain.collect</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="type_company" position="after">
                <filter string="Persons without Company" name="without_company"
                        domain="[&quot;&amp;&quot;, (&quot;is_company&quot;, &quot;=&quot;, False), &quot;&amp;&quot;, (&quot;parent_id&quot;, &quot;=&quot;, False), (&quot;company_name&quot;, &quot;=&quot;, False)]"/>
                <filter string="Persons with Suggested Companies" name="with_suggested_company"
                        domain="[&quot;&amp;&quot;, (&quot;is_company&quot;, &quot;=&quot;, False), (&quot;suggested_company_ids_bareos&quot;, &quot;!=&quot;, False)]"/>
            </filter>
        </field>
    </record>
</odoo>
